{
  "manifest_version": 2,
  "version": "0.1.0",
  "name": "MaiBot-MaiGO-Adapter",
  "description": "轻量连接 MaiGO 跨端记忆与生活流中心：自动采集互通群/私聊发言、向规划与回复双钩子按可见性注入慢快记忆视图及跨端熟人名片，并承接开播喊人与经历检索工具。",
  "author": {
    "name": "MaiGO 贡献者",
    "url": "https://github.com/Mai-with-u"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Mai-with-u/MaiBot"
  },
  "plugin_type": "adapter",
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.16.0",
    "max_version": "2.99.99"
  },
  "dependencies": [],
  "capabilities": [
    "chat.get_stream_by_group_id",
    "maisaka.proactive.trigger",
    "config.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  },
  "id": "maigo.maibot-adapter"
}
